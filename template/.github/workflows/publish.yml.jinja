name: Publish

on:
  workflow_run:
    workflows: ["Release Please"]
    types: [completed]
  workflow_dispatch:
    inputs:
      tag:
        description: "Release tag to publish (e.g. {{ project_slug }}-v0.1.0 or v0.1.0)"
        required: true

permissions:
  contents: read
  id-token: write   # Trusted Publisher (PyPI OIDC)

jobs:
  check:
    name: Check release tag
    if: >
      github.event_name == 'workflow_dispatch' ||
      (github.event.workflow_run.conclusion == 'success' &&
       github.event.workflow_run.head_branch == 'master')
    runs-on: ubuntu-latest
    outputs:
      tag: ${% raw %}{{ steps.tag.outputs.tag }}{% endraw %}
    steps:
      - uses: actions/checkout@v6
        with:
          ref: ${% raw %}{{ github.event_name == 'workflow_dispatch' && inputs.tag || github.event.workflow_run.head_sha }}{% endraw %}
          fetch-tags: true

      - name: Resolve tag
        id: tag
        run: |
          if [ "${% raw %}{{ github.event_name }}{% endraw %}" = "workflow_dispatch" ]; then
            echo "tag=${% raw %}{{ inputs.tag }}{% endraw %}" >> "$GITHUB_OUTPUT"
          else
            # Accept both tag conventions: the component-prefixed one and the
            # bare one, so a Release Please config change cannot silently stop
            # publishing.
            TAG=$(git tag --points-at HEAD | grep -E '^({{ project_slug }}-)?v[0-9]' | head -1)
            echo "tag=$TAG" >> "$GITHUB_OUTPUT"
            if [ -z "$TAG" ]; then
              echo "No release tag on this commit — skipping publish."
            else
              echo "Will publish $TAG"
            fi
          fi

  publish:
    name: Build and publish to PyPI
    needs: check
    if: needs.check.outputs.tag != ''
    runs-on: ubuntu-latest
    environment: pypi
    steps:
      - uses: actions/checkout@v6
        with:
          ref: ${% raw %}{{ needs.check.outputs.tag }}{% endraw %}

      - uses: astral-sh/setup-uv@v7

      - name: Set version from release tag
        run: |
          VERSION="${% raw %}{{ needs.check.outputs.tag }}{% endraw %}"
          VERSION="${VERSION#{{ project_slug }}-}"
          VERSION="${VERSION#v}"
          echo "__version__ = \"$VERSION\"  # x-release-please-version" > {{ package_name }}/__version__.py

      - run: uv build
      - run: uv publish
