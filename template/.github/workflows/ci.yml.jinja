name: CI

on:
  push:
    branches: [master]
  pull_request:
    branches: [master]

jobs:
  lint:
    name: Lint & type check
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: astral-sh/setup-uv@v7
      - run: uv sync --group dev --all-extras
      - run: uv run ruff check
      - run: uv run ruff format --check
      - run: uv run mypy {{ package_name }}

  test-unit:
    name: Unit tests (Python ${% raw %}{{ matrix.python-version }}{% endraw %})
    needs: lint
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        python-version: [{% for minor in range(python_min_version.split(".")[1] | int, python_max_version.split(".")[1] | int + 1) %}"3.{{ minor }}"{{ ", " if not loop.last }}{% endfor %}]
    steps:
      - uses: actions/checkout@v7
      - uses: astral-sh/setup-uv@v7
        with:
          python-version: ${% raw %}{{ matrix.python-version }}{% endraw %}
      - run: uv sync --group dev --all-extras
      - run: uv run pytest -m unit --cov={{ package_name }} --cov-report=xml --cov-fail-under=90
      - uses: codecov/codecov-action@v6
        if: matrix.python-version == '{{ python_max_version }}'
        with:
          token: ${% raw %}{{ secrets.CODECOV_TOKEN }}{% endraw %}
          files: coverage.xml
        continue-on-error: true

  test-integration:
    name: Integration tests
    needs: lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: astral-sh/setup-uv@v7
      - run: uv sync --group dev --all-extras
      - name: Run integration tests
        run: |
          set +e
          uv run pytest -m integration
          STATUS=$?
          set -e
          test $STATUS -eq 0 -o $STATUS -eq 5

  # Sentinel job — the single required status check in the master ruleset. A job
  # counts only when it succeeded: "skipped" means the work did not happen. A job
  # skipped by design (one that runs on pull requests only, say) goes in MAY_SKIP
  # by its job id, and only those may end skipped.
  all-checks-passed:
    name: All checks passed
    if: always()
    needs: [lint, test-unit, test-integration]
    runs-on: ubuntu-latest
    steps:
      - name: Check all jobs succeeded
        env:
          NEEDS: ${% raw %}{{ toJSON(needs) }}{% endraw %}
          MAY_SKIP: '[]'
        run: |
          NOT_PASSED=$(jq -r --argjson skip "$MAY_SKIP" '
            to_entries[]
            | select((.value.result == "success" or (.value.result == "skipped" and (.key | IN($skip[])))) | not)
            | "\(.key): \(.value.result)"' <<< "$NEEDS")
          if [ -n "$NOT_PASSED" ]; then
            echo "Not passed:"
            echo "$NOT_PASSED"
            exit 1
          fi
          echo "All checks passed."
